# Better Auth environment variables
# Copy to `.dev.vars` for local Cloudflare Workers / Wrangler dev.
# In production, set secrets via `wrangler secret put <NAME>`.

# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# 32+ byte random secret used by Better Auth to sign sessions/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret

# Single admin email (case-insensitive). Only this verified account
# receives `role: "admin"` and access to /admin/* and /api/admin/*.
ADMIN_EMAIL=admin@example.com

# Primary login uses Shoo (https://shoo.dev) OIDC + PKCE with zero OAuth setup.
# Optional overrides if you self-host Shoo or use a custom client ID:
# SHOO_BASE_URL=https://shoo.dev
# SHOO_CLIENT_ID=origin:http://localhost:3000

# Optional fallback: direct Google OAuth 2.0 Web Client credentials
# (see docs/setup-google-oauth.md). Leave unset to use Shoo only.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
